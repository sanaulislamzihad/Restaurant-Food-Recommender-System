# ============================================================================
# Copy to `.env` and adjust. Never commit the real `.env`.
# ============================================================================

# ---- Database ----------------------------------------------------------
# SQLAlchemy URL. The engine is dialect-agnostic, so local dev can run on
# SQLite with no services while docker-compose and CI target Postgres.
#   local  : sqlite+pysqlite:///./foodrec.db
#   docker : postgresql+psycopg://foodrec:foodrec@db:5432/foodrec
DATABASE_URL=sqlite+pysqlite:///./foodrec.db

# ---- Cache -------------------------------------------------------------
# Leave REDIS_URL empty to fall back to an in-process TTL cache. That keeps
# the app runnable without Redis; set it in docker-compose for the real thing.
REDIS_URL=
CACHE_TTL_SECONDS=300

# ---- Auth --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-this-is-not-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Recommender tuning ------------------------------------------------
# Blend weight: score = alpha * collaborative + (1 - alpha) * content.
# Selected on validation by `python -m ml.evaluate`, not guessed.
RECO_ALPHA=0.2
# Below this many ratings a user is treated as cold-start (alpha forced to 0).
RECO_MIN_USER_RATINGS=5
# Below this many ratings an item is treated as cold-start (alpha forced to 0).
RECO_MIN_ITEM_RATINGS=3
# Target size of the candidate list produced by the retrieval stage.
RECO_CANDIDATE_TARGET=150
RECO_TOP_N=20
# Added to a promoted dish's score, in star units.
RECO_PROMOTION_BOOST=0.25
# Dishes ordered inside this window are kept out of the feed.
RECO_REPEAT_SUPPRESSION_HOURS=24

# ---- Model artifacts ---------------------------------------------------
MODEL_DIR=models
MODEL_VERSION=

# ---- App ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# A browser treats localhost and 127.0.0.1 as different origins; allow both in dev.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
