# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Environment ----
.env
.env.local
*.local

# ---- Databases ----
# Local SQLite dev databases are disposable; regenerate with `python -m scripts.seed`.
*.db
*.db-journal
*.sqlite3

# ---- ML artifacts ----
# Trained weights, curves and id maps are large and fully reproducible from the
# seed plus the training CLI, so they stay out of the repo. The metadata JSON
# model cards ARE committed: they are small, and they let a reviewer see what
# was trained and how it scored without running anything.
backend/models/**
!backend/models/**/
!backend/models/**/metadata.json

# ---- Node / Next.js ----
node_modules/
.next/
out/
build/
dist/
.turbo/
next-env.d.ts

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Seed sidecar metadata (regenerated by scripts/seed.py)
backend/data/
